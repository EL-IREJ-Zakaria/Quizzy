<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA">

    <View
        android:id="@+id/header_bg"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:background="@color/purple_500"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_category_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="Choose Category"
        android:textColor="@android:color/white"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_category_title">

        <GridLayout
            android:id="@+id/gl_categories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:padding="16dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_geography"
                style="@style/CategoryCardStyle">
                <TextView style="@style/CategoryTextStyle" android:text="Geography" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_science"
                style="@style/CategoryCardStyle">
                <TextView style="@style/CategoryTextStyle" android:text="Science" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_history"
                style="@style/CategoryCardStyle">
                <TextView style="@style/CategoryTextStyle" android:text="History" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_art"
                style="@style/CategoryCardStyle">
                <TextView style="@style/CategoryTextStyle" android:text="Art" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_sports"
                style="@style/CategoryCardStyle">
                <TextView style="@style/CategoryTextStyle" android:text="Sports" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_movies"
                style="@style/CategoryCardStyle">
                <TextView style="@style/CategoryTextStyle" android:text="Movies" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_music"
                style="@style/CategoryCardStyle">
                <TextView style="@style/CategoryTextStyle" android:text="Music" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_literature"
                style="@style/CategoryCardStyle">
                <TextView style="@style/CategoryTextStyle" android:text="Literature" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_nature"
                style="@style/CategoryCardStyle">
                <TextView style="@style/CategoryTextStyle" android:text="Nature" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_technology"
                style="@style/CategoryCardStyle">
                <TextView style="@style/CategoryTextStyle" android:text="Technology" />
            </com.google.android.material.card.MaterialCardView>

        </GridLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
